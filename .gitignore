# Local configuration and secrets
.env
.env.*
!.env.example
*.sqlite
*.db
user_data/
logs/
*.log
__pycache__/
.DS_Store

# Node build artifacts
**/node_modules/
**/.next/

# Collection de stratégies de recherche : conserver le catalogue, pas les
# clones externes, imports volumineux ou sorties générées.
strategy_library/imports/
strategy_library/generated/
strategy_library/support/
strategy_library/legacy/
strategy_library/sources/*/
strategy_library/audit_results/*
!strategy_library/audit_results/.gitignore
!strategy_library/README.md
!strategy_library/CATALOG.md
!strategy_library/sources/README.md

# Ancien nom conservé pour les installations locales existantes.
strategies-library/

# Journaux exportes depuis Coolify.
deployment-*.txt
*-logs-*.txt

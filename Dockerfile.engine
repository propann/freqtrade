# Moteur Freqtrade officiel, augmente du code du rack.
# Le code vient de l'image (donc du commit deploye), jamais d'un montage :
# un bind mount relatif arrive vide chez la plupart des orchestrateurs.
# Pinned digest: update deliberately through the dependency-watch procedure.
FROM freqtradeorg/freqtrade:stable@sha256:50720a4af314a812be2cfbf5cc6331c63e9332b06f3f4372241f54bc61a35486

USER root
# Required by the vetted legacy strategies GodStra and Heracles.  Keep this
# pinned so local research and the future VPS image resolve the same API.
RUN pip install --no-cache-dir "ta==0.11.0"
COPY scripts/ /opt/quant/scripts/
COPY quant_rack/ /opt/quant/quant_rack/
COPY strategies/ /opt/quant/strategies/
COPY config_examples/ /opt/quant/config_examples/
RUN chmod -R a+rX /opt/quant \
 && chmod a+x /opt/quant/scripts/start-engine
USER ftuser

ENTRYPOINT ["/bin/sh", "/opt/quant/scripts/start-engine"]

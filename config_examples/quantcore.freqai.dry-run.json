{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "quant-core-freqai-cpu",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.8,
  "timeframe": "15m",
  "strategy": "FreqaiCpuStrategy",
  "freqaimodel": "LightGBMRegressor",
  "exchange": {"name": "binance", "key": "", "secret": "", "ccxt_config": {"enableRateLimit": true}, "ccxt_async_config": {"enableRateLimit": true}, "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"], "pair_blacklist": []},
  "pairlists": [{"method": "StaticPairList"}],
  "freqai": {"enabled": true, "identifier": "freqai-cpu-v1", "purge_old_models": 2, "train_period_days": 30, "backtest_period_days": 7, "live_retrain_hours": 12, "feature_parameters": {"include_timeframes": ["15m", "1h"], "include_corr_pairlist": ["BTC/USDT", "ETH/USDT"], "label_period_candles": 12, "include_shifted_candles": 2, "indicator_periods_candles": [10, 20]}, "data_split_parameters": {"test_size": 0.25, "random_state": 1}, "model_training_parameters": {}, "data_kitchen_thread_count": 1, "write_metrics_to_disk": true}
}

{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "quant-core-backtest",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "margin_mode": "",
  "timeframe": "15m",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "stoploss": -0.08,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true},
    "ccxt_async_config": {"enableRateLimit": true},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "LINK/USDT",
      "AVAX/USDT"
    ],
    "pair_blacklist": [".*(UP|DOWN|BULL|BEAR)/.*"]
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  }
}

{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "quant-core-micro-dryrun",
  "dry_run": true,
  "dry_run_wallet": 60,
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 10,
  "tradable_balance_ratio": 0.8,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true},
    "ccxt_async_config": {"enableRateLimit": true},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "LINK/USDT",
      "AVAX/USDT"
    ],
    "pair_blacklist": [".*(UP|DOWN|BULL|BEAR)/.*"]
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  }
}

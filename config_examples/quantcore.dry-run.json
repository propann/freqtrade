{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "quant-core-dry-run",
  "strategy": "QuantCoreBaseline",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "EUR",
  "cancel_open_orders_on_exit": false,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true},
    "ccxt_async_config": {"enableRateLimit": true},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "LINK/USDT",
      "AVAX/USDT"
    ],
    "pair_blacklist": [
      ".*(UP|DOWN|BULL|BEAR)/.*"
    ]
  },
  "pairlists": [
    {"method": "StaticPairList"},
    {"method": "AgeFilter", "min_days_listed": 90},
    {"method": "PrecisionFilter"},
    {"method": "PriceFilter", "low_price_ratio": 0.01},
    {"method": "SpreadFilter", "max_spread_ratio": 0.005}
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "authorized_users": []
  },
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {"process_throttle_secs": 5}
}

# Copy this file to .env and replace every change-me value.
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=3000
FREQTRADE_PUBLIC_DOMAIN=localhost
CONSOLE_CPU_LIMIT=0.5
CONSOLE_MEMORY_LIMIT=512m
FREQTRADE_CPU_LIMIT=1.0
FREQTRADE_MEMORY_LIMIT=1024m
FREQTRADE_PIDS_LIMIT=256
FREQTRADE_API_TIMEOUT_MS=3000
RESEARCH_CPU_LIMIT=1.0
RESEARCH_MEMORY_LIMIT=1024m
RESEARCH_PIDS_LIMIT=256
QUANT_RESEARCH_TIMEOUT=3600
QUANT_BENCHMARK_TIMEOUT=600
QUANT_VALIDATION_TIMEOUT=3600
QUANT_OOS_TIMEOUT=3600
RACK_OPERATOR_CPU_LIMIT=0.25
RACK_OPERATOR_MEMORY_LIMIT=128m
QUANT_RACK_ACTOR=coolify-operator
OBSERVER_CPU_LIMIT=0.10
OBSERVER_MEMORY_LIMIT=64m
OBS_CPU_WARN_PCT=80
OBS_RAM_WARN_PCT=80
OBS_EXCHANGE_ERROR_WARN_COUNT=3

FREQTRADE_USERNAME=freqtrade_user
FREQTRADE_PASSWORD=change-me-freqtrade-password
FREQTRADE_API_JWT_SECRET=change-me-with-at-least-32-random-bytes
FREQTRADE_WS_TOKEN=change-me-with-a-random-websocket-token
# Secrets exchange: define them only in Coolify / the server, never in Git or the UI.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Telegram stays disabled until a freshly rotated token and the authorized user are set.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USERS=[]
FREQTRADE_ADMIN_USER=admin
FREQTRADE_ADMIN_PASSWORD=change-me-console-password
# Optional. Leave empty to disable PIN login.
FREQTRADE_PIN_CODE=
FREQTRADE_JWT_SECRET=change-me-with-at-least-32-random-bytes
